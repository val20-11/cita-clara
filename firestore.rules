rules_version = '2';

// Reglas de seguridad de Firestore para Cita Clara.
// - Lectura pública en reportes_espera y reportes_error para mostrar tiempos,
//   problemas frecuentes y el panel de transparencia.
// - Escritura bloqueada desde el navegador: solo el backend en Google Apps Script
//   escribe mediante Firestore REST API autenticado como cuenta de servicio.
service cloud.firestore {
  match /databases/{database}/documents {

    match /reportes_espera/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /reportes_error/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /avisos_cambio/{id} {
      allow read: if false;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}