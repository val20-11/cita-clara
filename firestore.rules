rules_version = '2';

// Reglas de seguridad de Firestore para Cita Clara.
// El catálogo es público de solo lectura. Su carga y actualización se hacen
// desde un entorno administrativo con Firebase Admin SDK (no desde el navegador).
// Los reportes se leen desde el cliente, pero las escrituras pasan por Apps Script.
service cloud.firestore {
  match /databases/{database}/documents {

    match /catalogo_tramites/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /reportes_espera/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /reportes_error/{id} {
      allow read: if true;
      allow write: if false;
    }

    match /avisos_cambio/{id} {
      allow read: if false;
      allow write: if false;
    }

    // Denegación por defecto para cualquier otra colección/documento.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
